# Copy this file to .env.docker for local Docker development.
# Do not commit real secrets.

PORT=4000
MONGODB_URI=mongodb://mongo:27017/i-store-db
JWT_SECRET=replace-with-a-development-secret

# Firebase is required at backend startup.
# Provide one of these, or mount a service account file and set GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SA_JSON=
FIREBASE_SA_B64=
GOOGLE_APPLICATION_CREDENTIALS=/app/src/secret/serviceAccountKey.json

# Gmail/OAuth values used by birthday email jobs and related email code.
SECRET=
CLIENT_ID=
REFRESH_TOKEN=
REDIRECT_URI=
EMAIL=
