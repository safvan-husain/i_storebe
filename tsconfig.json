{
    "compilerOptions": {
      "target": "es2020",
      "module": "commonjs",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "./dist",
      // "types": ["node"],
      // "typeRoots": ["./src/types", "./node_modules/@types", "./types"],
      "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"],
    "exclude": ["node_modules"],
    "ts-node": {
      "files": true
    }
  }