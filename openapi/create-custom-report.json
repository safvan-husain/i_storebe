                        "choice"
                      ]
                    },
                    "helpText": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean",
                      "default": false
                    },
                    "showIf": {
                      "type": "object",
                      "properties": {
                        "questionIndex": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "choiceIndexEquals": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "exists": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "questionIndex"
                      ]
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "label": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string"
                          }
                        },
