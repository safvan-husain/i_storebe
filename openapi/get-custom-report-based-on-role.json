                          "textField"
                        ]
                      },
                      "helpText": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "showIf": {
                        "type": "object",
                        "properties": {
                          "questionId": {
                            "type": "string"
                          },
