                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "questionId": {
                        "type": "string"
                      },
                      "index": {
                        "type": "integer"
                      },
                      "query": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
